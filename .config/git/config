# Global git config. ~/.config/git is a symlink to this directory ([dotfiles]
# in ~/.config/mise/config.toml), so `git config --global` edits this file
# as long as ~/.gitconfig doesn't exist.

[user]
	name = Kirill Sysoev
	email = k.sysoev@me.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILQUdlfvHRBjMLM9TKWBxKvOBx5B0hHOf05rJSP5m/Me

# Sign every commit with the SSH key above.
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true

[url "git@github.com:"]
	insteadOf = https://github.com/
[pull]
	rebase = false
[push]
	autoSetupRemote = true

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
